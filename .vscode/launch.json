{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CarStore.Web (http)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Src/CarStore.Web/CarStore.Web.csproj",
      "launchProfileName": "http",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Src/CarStore.Web/Views"
      }
    }
  ]
}
